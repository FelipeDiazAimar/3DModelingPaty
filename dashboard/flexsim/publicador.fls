// Publicador del dashboard: cada 10 s simulados (delayednodefunction) envía un JSON compacto al puente
// (Next.js, /api/ingest). Vive en Tools/Publicar: no consume objetos de licencia.
// machines: id -> [estado, dentro, entradas, salidas]  estado: 0 inactiva 1 procesando 2 bloqueada 3 sin material 4 falla
// fleet:    id -> [x, y, estado, conCarga, traslados]  estado: 0 esperando 1 viajando 2 cargando
// kpi: [palletsMP, palletsPT, cajasL7, cajasL8]
treenode self = model().find("Tools/Publicar");
treenode lastN = model().find("Tools/pubLast");
lastN.value = Model.time;

string ids = "Desencajado_L7,Picadora_L7,MezA_L7,MezB_L7,FormA_L7,FormB_L7,Tunel_L7,EnvA_L7,EnvB_L7,EncA_L7,EncB_L7,EstA_L7,Desencajado_L8,Picadora_L8,MezA_L8,MezB_L8,FormA_L8,FormB_L8,Tunel_L8,EnvA_L8,EnvB_L8,EncA_L8,EncB_L8,EstA_L8,QRecepcion,RackMPCongelado,RackMPEnfriado,RackPTCongelado,RackPTEnfriado,QExpedicion,SrcCamionesMP,SinkExpedicion";
string fl = "MontacargasRecep,MontacargasAlmacenMP,MontacargasLineaPT,MontacargasExped";

string js = "{\"run\":" + string.fromNum(model().find("Tools/pubRun").value) + ",\"t\":" + string.fromNum(Model.time, 1) + ",\"m\":{";
Array a = ids.split(",");
for (int i = 1; i <= a.length; i++) {
	Object o = Model.find(a[i]);
	if (!objectexists(o)) continue;
	int sn = getstatenum(o);
	int st = 0;
	if (sn == 2 || sn == 3 || sn == 5 || sn == 7 || sn == 8 || sn == 21) st = 1;
	else if (sn == 4 || sn == 23) st = 2;
	else if (sn == 9) st = 3;
	else if (sn == 20) st = 4;
	js = js + "\"" + a[i] + "\":[" + string.fromNum(st) + "," + string.fromNum(content(o)) + "," + string.fromNum(getinput(o)) + "," + string.fromNum(getoutput(o)) + "],";
}
js = js + "\"_\":[0,0,0,0]},\"f\":{";
Array b = fl.split(",");
for (int i = 1; i <= b.length; i++) {
	Object f = Model.find(b[i]);
	if (!objectexists(f)) continue;
	int sn = getstatenum(f);
	int st = 0;
	if (sn == 14 || sn == 15) st = 1;
	else if (sn == 18 || sn == 19) st = 2;
	int car = 0;
	if (content(f) > 0) car = 1;
	js = js + "\"" + b[i] + "\":[" + string.fromNum(f.location.x, 1) + "," + string.fromNum(f.location.y, 1) + "," + string.fromNum(st) + "," + string.fromNum(car) + "," + string.fromNum(getinput(f)) + "],";
}
js = js + "\"_\":[0,0,0,0,0]},";

int pmp = getinput(Model.find("QRecepcion"));
int ppt = getinput(Model.find("SinkExpedicion"));
int c7 = getoutput(Model.find("EncA_L7")) + getoutput(Model.find("EncB_L7"));
int c8 = getoutput(Model.find("EncA_L8")) + getoutput(Model.find("EncB_L8"));
js = js + "\"k\":[" + string.fromNum(pmp) + "," + string.fromNum(ppt) + "," + string.fromNum(c7) + "," + string.fromNum(c8) + "]}";

Http.Request req;
req.host = "127.0.0.1";
req.port = 3000;
req.path = "/api/ingest";
req.method = Http.Method.Post;
req.headers = "Content-Type: application/json";
req.data = js;
req.timeout = 800;
req.send();

delayednodefunction(self, 10, 0);
return 0;
