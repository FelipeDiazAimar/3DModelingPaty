// Tools/svgLineas(titulo, unidad, historial, columnas, nombres, colores, nota): gráfico de líneas en SVG
// con el tiempo simulado (h) en X. historial = filas de Tools/indHist; columnas = índices (1 = horas).
string tit = param(1);
string uni = param(2);
Array H = param(3);
Array cols = param(4);
Array nom = param(5);
Array col = param(6);
string nota = param(7);
string s = "<div class='card'><div class='ct'>" + tit + " <span class='u'>" + uni + "</span></div>";
int n = H.length;
if (n < 2) return s + "<div class='vacio'>Sin datos todavía: hacé Reset y Run.</div></div>";
double t0 = H[1][1];
double t1 = H[n][1];
if (t1 <= t0) t1 = t0 + 1;
double vmax = 0;
for (int i = 1; i <= n; i++) for (int k = 1; k <= cols.length; k++) vmax = Math.max(vmax, H[i][cols[k]]);
if (vmax <= 0) vmax = 1;
double p = Math.pow(10, Math.floor(log(vmax) / log(10)));
double m = vmax / p;
double nm = 10;
if (m <= 1) nm = 1; else if (m <= 2) nm = 2; else if (m <= 5) nm = 5;
vmax = nm * p;
double W = 600; double HH = 230; double L = 56; double R = 14; double T = 12; double B = 26;
double pw = W - L - R; double ph = HH - T - B;
s = s + "<svg viewBox='0 0 600 230'>";
for (int g = 0; g <= 4; g++) {
	double y = T + ph - ph * g / 4;
	s = s + "<line x1='" + string.fromNum(L) + "' x2='" + string.fromNum(W - R) + "' y1='" + string.fromNum(y, 1) + "' y2='" + string.fromNum(y, 1) + "' class='gr'/>";
	double v = vmax * g / 4;
	s = s + "<text x='" + string.fromNum(L - 6) + "' y='" + string.fromNum(y + 4, 1) + "' class='ay' text-anchor='end'>" + string.fromNum(v, v < 10 && vmax < 10 ? 1 : 0) + "</text>";
}
for (int g = 0; g <= 4; g++) {
	double x = L + pw * g / 4;
	s = s + "<text x='" + string.fromNum(x, 1) + "' y='" + string.fromNum(HH - 6) + "' class='ay' text-anchor='middle'>" + string.fromNum(t0 + (t1 - t0) * g / 4, 1) + " h</text>";
}
int paso = Math.max(1, Math.ceil(n / 300));
for (int k = 1; k <= cols.length; k++) {
	string pts = "";
	for (int i = 1; i <= n; i += paso) {
		double x = L + pw * (H[i][1] - t0) / (t1 - t0);
		double y = T + ph - ph * H[i][cols[k]] / vmax;
		pts = pts + string.fromNum(x, 1) + "," + string.fromNum(y, 1) + " ";
	}
	string dash = "";
	if (nom[k].indexOf("Nominal") == 1 || nom[k].indexOf("Estándar") == 1) dash = " stroke-dasharray='6 4'";
	s = s + "<polyline points='" + pts + "' fill='none' stroke='" + col[k] + "' stroke-width='2'" + dash + "/>";
}
s = s + "</svg><div class='lg'>";
for (int k = 1; k <= cols.length; k++) s = s + "<span><i style='background:" + col[k] + "'></i>" + nom[k] + " <b>" + string.fromNum(H[n][cols[k]], Math.fmod(H[n][cols[k]], 1) != 0 && H[n][cols[k]] < 10 ? 1 : 0) + "</b></span>";
s = s + "</div>";
if (nota.length > 0) s = s + "<div class='nota'>" + nota + "</div>";
return s + "</div>";
