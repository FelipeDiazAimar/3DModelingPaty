// Tools/Cinematica: recorrido automatico de la camara 3D (APAGADO por defecto: Tools/cinOn = 0).
// Con cinOn = 1 el modelo llama flyto(sv(), ...) desde sus eventos; en las pruebas eso hizo que el reloj de la barra de
// herramientas de FlexSim dejara de repintarse durante la corrida (con cinOn = 0 avanza bien), asi que el recorrido se hace
// desde afuera al grabar (flyto por el MCP). Unidad de la duracion de flyto: decimas de segundo (60 = 6 s; 1 = salto instantaneo).
// Requiere una vista en PERSPECTIVA designada con clic derecho > "Set as (sv)".
// Puntos en Tools/cinW ("x,y,z,rx,ry,rz;..."), cinP = segundos reales por tramo (8).
treenode T = model().find("Tools");
if (T.find("cinOn").value <= 0) return 0;
double P = T.find("cinP").value;
Array W = T.find("cinW").value.split(";");
int n = W.length;
double rt = realtime();
double el = rt - T.find("cinT0").value;
int k = floor(el / P);
double ck = T.find("cinK").value;
int tgt = -1;
int dur = 0;
if (ck <= -2) { tgt = 1; dur = 1; T.find("cinK").value = -1; }
else if (ck <= -1) { tgt = 2; dur = floor(P * 7.5); T.find("cinK").value = 0; }
else if (k > ck) { tgt = 1 + (k + 1) % n; dur = floor(P * 7.5); T.find("cinK").value = k; }
if (tgt > 0) {
	Array w = W[tgt].split(",");
	flyto(sv(), dur, stringtonum(w[1]), stringtonum(w[2]), stringtonum(w[3]), stringtonum(w[4]), stringtonum(w[5]), stringtonum(w[6]));
}
double pr = T.find("cinPR").value;
double ratio = 4;
if (pr > 0 && rt > pr) ratio = (Model.time - T.find("cinPS").value) / (rt - pr);
if (ratio < 0.5) ratio = 0.5;
double d = 0.25 * ratio;
if (d < 0.05) d = 0.05;
T.find("cinPS").value = Model.time;
T.find("cinPR").value = rt;
delayednodefunction(model().find("Tools/Cinematica"), d, 0);
return 0;
